{
    "Docs": {
        "prefix": "docs",
        "body": [
            "{% docs ${1:name} %}",
            "$2",
            "{% enddocs %}"
        ],
        "description": "Docs"
    },
    // TODO: add more callout types,see https://github.com/MeanderingProgrammer/render-markdown.nvim/wiki/Callouts
    "callout_todo": {
        "prefix": "todo",
        "body": [
            "> [!TODO]",
            "> $1"
        ],
        "description": "Callout TODO"
    }
}
